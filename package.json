{
  "name": "agentry-monorepo",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Agentry — Playwright for AI Agents. Monorepo root.",
  "license": "Apache-2.0",
  "engines": { "node": ">=20" },
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "build": "pnpm -r build",
    "agentry": "tsx packages/cli/src/bin.ts",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "pnpm -r build && changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.1",
    "@types/node": "^22.10.0",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
